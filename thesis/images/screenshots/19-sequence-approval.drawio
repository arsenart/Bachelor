<mxfile host="app.diagrams.net">
  <diagram id="seq-approval" name="Sequence: Approval Flow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="actorRequester" value="Žadatel" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lifelineRequester" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 4;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="110" as="sourcePoint" />
            <mxPoint x="100" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="objController" value=":WebApprovalController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="160" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objRequestService" value=":ApprovalRequestService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="180" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objRouting" value=":ApprovalRoutingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="180" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objWorkflow" value=":ApprovalWorkflowService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="40" width="180" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objAudit" value=":AuditLogService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="40" width="160" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objEmail" value=":EmailService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="40" width="160" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="objDB" value=":Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1560" y="40" width="160" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="actorApprover" value="Schvalovatel" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="40" height="60" as="geometry" />
        </mxCell>

        <mxCell id="phase1" value="FÁZE 1: Žadatel odešle žádost ke schválení" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="msg1" value="POST /requests/{id}/submit" style="html=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="180" as="sourcePoint" />
            <mxPoint x="300" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg2" value="submit(requestId, user)" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="210" as="sourcePoint" />
            <mxPoint x="530" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg3" value="buildStepsForRequest(req)" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="240" as="sourcePoint" />
            <mxPoint x="770" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg4" value="SELECT FROM approval_rules&#10;WHERE type=? AND amount BETWEEN ?" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="770" y="270" as="sourcePoint" />
            <mxPoint x="1640" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg5" value="rules: List" style="html=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1640" y="300" as="sourcePoint" />
            <mxPoint x="770" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="resolveApprover():&#10;-- if rule.approver != null → použij ho&#10;-- else if rule.approverRole != null → najdi prvního aktivního&#10;-- ověř že approver != requester (self-approval check)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="320" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="msg6" value="steps: List&lt;ApprovalStep&gt;" style="html=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="770" y="420" as="sourcePoint" />
            <mxPoint x="530" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg7" value="INSERT INTO approval_steps&#10;UPDATE approval_requests SET status='PENDING_APPROVAL'" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="450" as="sourcePoint" />
            <mxPoint x="1640" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg8" value="log('SUBMITTED')" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="480" as="sourcePoint" />
            <mxPoint x="1240" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg9" value="sendApprovalNeededEmail()" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="510" as="sourcePoint" />
            <mxPoint x="1440" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="phase2" value="FÁZE 2: Schvalovatel rozhoduje o žádosti" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="msg10" value="POST /approvals/{id}/approve" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="670" as="sourcePoint" />
            <mxPoint x="300" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg11" value="approve(requestId, user, comment)" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="700" as="sourcePoint" />
            <mxPoint x="1010" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note2" value="loadAndValidate():&#10;-- request.status == PENDING_APPROVAL?&#10;-- activeStep.approver == currentUser?&#10;jinak BusinessRuleViolationException → ROLLBACK" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="920" y="730" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="msg12" value="UPDATE approval_steps SET status='APPROVED'" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="820" as="sourcePoint" />
            <mxPoint x="1640" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note3" value="poslední krok? → status='APPROVED', notifikace žadateli&#10;jinak → další krok PENDING, notifikace dalšímu schvalovateli" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="920" y="850" width="460" height="50" as="geometry" />
        </mxCell>

        <mxCell id="msg13" value="log('APPROVED', oldStatus, newStatus, comment)" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="920" as="sourcePoint" />
            <mxPoint x="1240" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg14" value="sendRequestDecisionEmail() / sendApprovalNeededEmail()" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="950" as="sourcePoint" />
            <mxPoint x="1440" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg15" value="HTTP 302 → /approvals" style="html=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="990" as="sourcePoint" />
            <mxPoint x="100" y="990" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
